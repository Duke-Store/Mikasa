<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>لوحة تحكم السيرفر - بوت Mikasa</title>
  <link rel="icon" href="https://i.ibb.co/Hq8V39j/image.png" type="image/png">
  <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
  <script>const csrfToken = '<%= csrfToken %>';</script>
  <style>
    /* Additional server-dashboard specific overrides */
    :root {
      --primary-color: #2445b3;
      --background-color: #1a1a1a;
      --card-background: #2c2c2c;
      --text-color: #ffffff;
    }
    .server-info { background: linear-gradient(135deg, #2445b3 0%, #1a3a7a 100%); }
    .marketplace-tab { margin-top: 30px; }
    .marketplace-tab .product-grid { grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); }
  </style>
</head>
<body>
  <header>
    <nav>
      <div class="logo">
        <img src="https://i.ibb.co/Hq8V39j/image.png" alt="Logo">
        <h1 class="lang-ar">لوحة تحكم السيرفر</h1>
        <h1 class="lang-en" style="display: none;">Server Dashboard</h1>
      </div>
      <div class="nav-links">
        <a href="/dashboard" class="lang-ar">الرئيسية</a>
        <a href="/dashboard" class="lang-en" style="display: none;">Home</a>
        <a href="/marketplace" class="lang-ar">السوق</a>
        <a href="/marketplace" class="lang-en" style="display: none;">Marketplace</a>
        <a href="/dashboard/<%= guild.id %>" class="active lang-ar">إدارة السيرفر</a>
        <a href="/dashboard/<%= guild.id %>" class="active lang-en" style="display: none;">Manage</a>
        <a href="https://discord.gg/WYHntTJ54b" class="lang-ar">المساعدة</a>
        <a href="https://discord.gg/WYHntTJ54b" class="lang-en" style="display: none;">Help</a>
      </div>
      <button class="language-toggle" onclick="toggleLanguage()">
        <span class="lang-ar">English</span>
        <span class="lang-en" style="display: none;">عربي</span>
      </button>
    </nav>
  </header>

  <div class="server-info">
    <img src="<%= server.icon %>" alt="<%= server.name %>" class="server-icon" style="<%= server.icon ? '' : 'display: none;' %>">
    <h2 style="<%= server.icon ? '' : 'margin-top: 15px;' %>"><%= server.name %></h2>
  </div>

  <main class="container">
    <div class="command-list">
      <% ['antispam', 'antiraid', 'antiscam', 'antilink'].forEach(protectionType => { %>
        <div class="command-card">
          <div class="command-name">
            <span class="lang-ar"><%= {
              'antispam': '🚫 مكافحة السبام',
              'antiraid': '🛑 مكافحة الريد',
              'antiscam': '🕵️ مكافحة الاحتيال',
              'antilink': '🔗 مكافحة الروابط'
            }[protectionType] %></span>
            <span class="lang-en" style="display: none;"><%= {
              'antispam': '🚫 Anti-Spam',
              'antiraid': '🛑 Anti-Raid',
              'antiscam': '🕵️ Anti-Scam',
              'antilink': '🔗 Anti-Link'
            }[protectionType] %></span>
          </div>
          <p class="lang-ar"><%= {
            'antispam': 'حماية السيرفر من الرسائل المتكررة',
            'antiraid': 'حماية السيرفر من هجمات الريد',
            'antiscam': 'حماية الأعضاء من محاولات الاحتيال',
            'antilink': 'منع نشر الروابط غير المرغوب فيها'
          }[protectionType] %></p>
          <p class="lang-en" style="display: none;"><%= {
            'antispam': 'Protect the server from repeated messages',
            'antiraid': 'Protect the server from raid attacks',
            'antiscam': 'Protect members from scam attempts',
            'antilink': 'Prevent posting unwanted links'
          }[protectionType] %></p>
          <label class="toggle-switch">
            <input type="checkbox" <%= db.get(`${guild.id}_${protectionType}`) ? 'checked' : '' %> onchange="toggleProtection('<%= protectionType %>', this.checked, '<%= guild.id %>')">
            <span class="slider"></span>
          </label>
        </div>
      <% }); %>

      <% ['antichandeldelete', 'antichanelcreate', 'antichanneledit', 'antirolecreate', 'antiroledelete', 'antiroleedit'].forEach(protectionType => { %>
        <div class="command-card">
          <div class="command-name">
            <span class="lang-ar"><%= {
              'antichandeldelete': '🗑️ مكافحة حذف القنوات',
              'antichanelcreate': '➕ مكافحة إنشاء القنوات',
              'antichanneledit': '✏️ مكافحة تعديل القنوات',
              'antirolecreate': '🏷️ مكافحة إنشاء الأدوار',
              'antiroledelete': '🗑️ مكافحة حذف الأدوار',
              'antiroleedit': '✏️ مكافحة تعديل الأدوار'
            }[protectionType] %></span>
            <span class="lang-en" style="display: none;"><%= {
              'antichandeldelete': '🗑️ Anti-Channel Delete',
              'antichanelcreate': '➕ Anti-Channel Create',
              'antichanneledit': '✏️ Anti-Channel Edit',
              'antirolecreate': '🏷️ Anti-Role Create',
              'antiroledelete': '🗑️ Anti-Role Delete',
              'antiroleedit': '✏️ Anti-Role Edit'
            }[protectionType] %></span>
          </div>
          <p class="lang-ar"><%= {
            'antichandeldelete': 'منع حذف القنوات بدون إذن',
            'antichanelcreate': 'منع إنشاء قنوات جديدة بدون تصريح',
            'antichanneledit': 'منع تعديل إعدادات القنوات بدون إذن',
            'antirolecreate': 'منع إنشاء أدوار جديدة بدون تصريح',
            'antiroledelete': 'منع حذف الأدوار بدون تصريح',
            'antiroleedit': 'منع تعديل صلاحيات الأدوار بدون تصريح'
          }[protectionType] %></p>
          <p class="lang-en" style="display: none;"><%= {
            'antichandeldelete': 'Prevent channel deletion without permission',
            'antichanelcreate': 'Prevent creating new channels without authorization',
            'antichanneledit': 'Prevent editing channel settings without permission',
            'antirolecreate': 'Prevent creating new roles without authorization',
            'antiroledelete': 'Prevent role deletion without permission',
            'antiroleedit': 'Prevent editing role permissions without permission'
          }[protectionType] %></p>
          <label class="toggle-switch">
            <input type="checkbox" <%= db.get(`${guild.id}_${protectionType}`) ? 'checked' : '' %> onchange="toggleProtection('<%= protectionType %>', this.checked, '<%= guild.id %>')">
            <span class="slider"></span>
          </label>
        </div>
      <% }); %>

      <% ['antiadmingrant', 'antiban', 'antikick'].forEach(protectionType => { %>
        <div class="command-card">
          <div class="command-name">
            <span class="lang-ar"><%= {
              'antiadmingrant': '🛡️ مكافحة منح صلاحيات الإدارة',
              'antiban': '🔨 مكافحة الحظر',
              'antikick': '👢 مكافحة الطرد'
            }[protectionType] %></span>
            <span class="lang-en" style="display: none;"><%= {
              'antiadmingrant': '🛡️ Anti-Admin Grant',
              'antiban': '🔨 Anti-Ban',
              'antikick': '👢 Anti-Kick'
            }[protectionType] %></span>
          </div>
          <p class="lang-ar"><%= {
            'antiadmingrant': 'منع منح صلاحيات الإدارة بدون تصريح',
            'antiban': 'منع حظر الأعضاء بدون إذن',
            'antikick': 'منع طرد الأعضاء بدون تصريح'
          }[protectionType] %></p>
          <p class="lang-en" style="display: none;"><%= {
            'antiadmingrant': 'Prevent granting admin permissions without authorization',
            'antiban': 'Prevent banning members without permission',
            'antikick': 'Prevent kicking members without permission'
          }[protectionType] %></p>
          <label class="toggle-switch">
            <input type="checkbox" <%= db.get(`${guild.id}_${protectionType}`) ? 'checked' : '' %> onchange="toggleProtection('<%= protectionType %>', this.checked, '<%= guild.id %>')">
            <span class="slider"></span>
          </label>
        </div>
      <% }); %>

      <% commands.forEach(command => { %>
        <div class="command-card">
          <div class="command-name"><%= command.name %></div>
          <p class="lang-ar"><%= command.description %></p>
          <p class="lang-en" style="display: none;"><%= command.descriptionEn || command.description %></p>
          <label class="toggle-switch">
            <input type="checkbox" <%= command.enabled ? 'checked' : '' %> onchange="toggleCommand('<%= command.name %>', this.checked, '<%= guild.id %>')">
            <span class="slider"></span>
          </label>
        </div>
      <% }); %>
    </div>

    <!-- Marketplace Management Tab -->
    <div class="marketplace-tab card">
      <div class="card-header">
        <h3 class="lang-ar">📦 إدارة السوق</h3>
        <h3 class="lang-en" style="display: none;">📦 Marketplace Management</h3>
        <a href="/marketplace" target="_blank" class="btn btn-primary">
          <span class="lang-ar">فتح السوق</span>
          <span class="lang-en" style="display: none;">Open Marketplace</span>
        </a>
      </div>
      <div class="product-grid">
        <% if (marketplaceProducts && marketplaceProducts.length > 0) { %>
          <% marketplaceProducts.forEach(product => { %>
            <div class="product-card" style="padding: 15px;">
              <h3 style="font-size: 1rem;"><%= product.name %></h3>
              <p><strong>الكاتب:</strong> <span class="lang-en" style="display: none;">Seller:</span> <%= product.sellerTag %></p>
              <p><strong>الفئة:</strong> <span class="lang-en" style="display: none;">Category:</span> <%= product.category %></p>
              <p><strong>السعر:</strong> <span class="lang-en" style="display: none;">Price:</span> <%= product.price %></p>
              <p><strong>الأصالة:</strong> <span class="lang-en" style="display: none;">Originality:</span>
                <span class="badge <%= product.originalityStatus === 'verified' ? 'badge-green' : product.originalityStatus === 'flagged' ? 'badge-red' : 'badge-yellow' %>">
                  <%= product.originalityStatus || 'pending' %>
                </span>
              </p>
              <p><strong>الحالة:</strong> <span class="lang-en" style="display: none;">Status:</span>
                <span class="badge <%= product.status === 'listed' ? 'badge-green' : product.status === 'sold' ? 'badge-red' : 'badge-yellow' %>">
                  <%= product.status %>
                </span>
              </p>
              <div class="review-actions" style="margin-top: 10px;">
                <button class="btn btn-danger" onclick="removeProduct('<%= product.productId %>')" style="padding: 5px 12px; font-size: 0.8rem;">
                  <span class="lang-ar">حذف</span>
                  <span class="lang-en" style="display: none;">Remove</span>
                </button>
              </div>
            </div>
          <% }) %>
        <% } else { %>
          <p style="color: #666; grid-column: 1/-1; text-align: center; padding: 20px;">
            <span class="lang-ar">لا توجد منتجات في السوق بعد.</span>
            <span class="lang-en" style="display: none;">No products in the marketplace yet.</span>
          </p>
        <% } %>
      </div>
    </div>
  </main>

  <footer>
    &copy; 2026 Mikasa Bot. All rights reserved.
  </footer>

  <script nonce="<%= nonce %>">
    const CSRF_TOKEN = '<%= csrfToken %>';

    function toggleCommand(commandName, isEnabled, guildId) {
      fetch('/api/toggle-command', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ commandName, isEnabled, guildId, _csrf: CSRF_TOKEN }),
      })
      .then(r => r.json())
      .then(data => {
        if (!data.success) console.error('Command toggle failed');
      })
      .catch(e => console.error('Error:', e));
    }

    function toggleProtection(protectionType, isEnabled, guildId) {
      fetch('/api/toggle-protection', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ protectionType, isEnabled, guildId, _csrf: CSRF_TOKEN }),
      })
      .then(r => r.json())
      .then(data => {
        if (!data.success) console.error('Protection toggle failed');
      })
      .catch(e => console.error('Error:', e));
    }

    function removeProduct(productId) {
      if (!confirm('Are you sure you want to remove this product?')) return;
      fetch('/api/remove-product', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ productId, _csrf: CSRF_TOKEN }),
      })
      .then(r => r.json())
      .then(data => {
        if (data.success) location.reload();
        else alert('Failed to remove product.');
      })
      .catch(e => alert('Error: ' + e.message));
    }

    function toggleLanguage() {
      const ar = document.querySelectorAll('.lang-ar');
      const en = document.querySelectorAll('.lang-en');
      ar.forEach(el => el.style.display = el.style.display === 'none' ? '' : 'none');
      en.forEach(el => el.style.display = el.style.display === 'none' ? '' : 'none');
    }
  </script>
</body>
</html>
