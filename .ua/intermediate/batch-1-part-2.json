    {
      "id": "file:utils.js",
      "type": "file",
      "name": "utils.js",
      "filePath": "utils.js",
      "summary": "Shared utility module exporting guild settings and user stats persistence, duration formatting/parsing, safe interaction replies, moderation logging, staff permission checks, ticket channel overwrites, and cooldown helpers used across the whole bot.",
