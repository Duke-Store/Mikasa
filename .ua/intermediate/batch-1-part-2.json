        "utility",
        "persistence",
        "discord",
        "shared-library"
      ],
      "complexity": "complex",
      "languageNotes": "Uses a per-file async write queue with atomic temp-file rename so concurrent guild settings and stats writes never clobber each other; a 30s unref’d interval sweeps expired cooldowns."
    },
